# Copy this file to ".env" and fill in your own values.   NEVER commit ".env" to GitHub.

# --- Daraja credentials: https://developer.safaricom.co.ke -> My Apps -> your app ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Sandbox test values (the "Lipa na M-Pesa Online" simulator on the portal shows the same shortcode and passkey)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Sandbox = https://sandbox.safaricom.co.ke      (go-live later = https://api.safaricom.co.ke)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# --- Optional: receive Safaricom's callback (gives you the M-Pesa receipt number) ---
# Safaricom must be able to reach this URL, so on your laptop use a tunnel such as ngrok:  ngrok http 5000
# Then set:  MPESA_CALLBACK_URL=https://YOUR-TUNNEL.ngrok-free.app/api/mpesa/callback/<the secret below>
MPESA_CALLBACK_SECRET=change-me-to-any-random-text
MPESA_CALLBACK_URL=

# --- Server ---
PORT=5000
# Only needed when the website is hosted somewhere else (e.g. Netlify):
# FRONTEND_ORIGIN=https://your-site.netlify.app
